{
  "name": "airbox",
  "version": "1.0.0",
  "productName": "Airbox",
  "description": "Airbox - Modern Open Source Streaming and Batch Downloader Studio",
  "main": "gui.js",
  "scripts": {
    "build:ts": "node scripts/build-ts.js",
    "prestart": "npm run build:ts",
    "start": "electron .",
    "prebuild": "node scripts/download-binaries.js",
    "build": "npm run build --prefix ../gui",
    "prepackage": "node scripts/download-binaries.js",
    "package": "npm run build:ts && node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && electron-builder --win --linux",
    "prepackage:mac": "node scripts/download-binaries.js",
    "package:mac": "npm run build:ts && node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && electron-builder --mac dmg zip --arm64",
    "prepackage:all": "node scripts/download-binaries.js",
    "package:all": "npm run build:ts && node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\" && electron-builder --win --linux --mac zip",
    "release": "bash release.sh",
    "start:prod": "cross-env NODE_ENV=production electron .",
    "postinstall": "electron-builder install-app-deps && node scripts/download-binaries.js",
    "package:win": "npm run build:ts && npm run build --prefix ../gui && electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ikonicity-airban/Airbox.git"
  },
  "build": {
    "appId": "com.airbox.app",
    "protocols": [
      {
        "name": "airbox-protocols",
        "schemes": [
          "airbox",
          "iconmedia"
        ]
      }
    ],
    "files": [
      "**/*",
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../gui/dist",
        "to": "gui/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Airbox.Setup.${version}.exe",
      "icon": "assets/airbox.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "ikonicity-airban",
      "repo": "Airbox",
      "private": false
    },
    "nsis": {
      "deleteAppDataOnUninstall": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "assets/airbox.png",
      "desktop": {
        "entry": {
          "MimeType": "x-scheme-handler/airbox;"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "assets/iconmedia.png",
      "identity": null,
      "artifactName": "Airbox-${version}-mac-arm64.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": false,
    "icon": "assets/airbox.png",
    "compression": "normal",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "ffmpeg/**/*",
      "assets/**/*",
      "mpv/**/*"
    ]
  },
  "keywords": [
    "anime",
    "manga",
    "mangadownloader",
    "animedownloader",
    "animebatchdownloader",
    "StrawVerse"
  ],
  "author": {
    "name": "TheYogMehta",
    "email": "mehtayog5@gmail.com",
    "url": "https://github.com/TheYogMehta"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "got": "^15.0.5",
    "iso-639-1": "^3.1.5",
    "jszip": "^3.10.1",
    "node-cache": "^5.1.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "undici": "^6.27.0 || ^7.27.3",
    "form-data": "^4.0.6",
    "builder-util-runtime": "^9.7.0",
    "js-yaml": "^4.3.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "github:devsnek/node-register-scheme#e7cc9a63a1f512565da44cb57316d9fb10750e17": true,
    "electron-winstaller@5.4.0": true
  }
}
