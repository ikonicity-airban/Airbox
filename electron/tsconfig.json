{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "types": ["node", "express"]
  },
  "include": [
    "*.ts",
    "scripts/*.ts",
    "../backend/**/*.ts"
  ]
}
